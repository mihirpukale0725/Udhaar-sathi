# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Gemini API key (https://aistudio.google.com/apikey).
# If empty, the app falls back to the regex-based Hinglish rules parser.
GEMINI_API_KEY=

# Shared secret used to sign/verify payment webhooks with HMAC-SHA256.
# Any long random string works, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me

# Optional: where the SQLite file lives (default: udhaar.db in the project root)
DB_PATH=udhaar.db
